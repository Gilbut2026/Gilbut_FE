# ===== AI 길벗 프론트엔드 환경변수 =====
# 지금은 Mock 데이터로 동작합니다. 백엔드(Spring Boot)가 준비되면 아래 두 줄만 바꾸세요.

# true  → 가짜(Mock) 응답으로 동작 (백엔드 없이도 화면 확인 가능)
# false → 실제 백엔드 API 호출
VITE_USE_MOCK=true

# 실제 백엔드 주소 (VITE_USE_MOCK=false 일 때 사용)
# 예: http://localhost:8080  또는  배포된 서버 주소
VITE_API_BASE_URL=http://localhost:8080
