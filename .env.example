# 이 파일을 복사해서 .env 로 만들어 사용하세요.

# ── 기본 동작 ────────────────────────────────────────────────
# true  → 전부 Mock (백엔드 없이 화면 확인 · 시연 안전판)
# false → 전부 실서버
VITE_USE_MOCK=true

# 백엔드 주소 (실서버 호출 시 사용)
# 2026-08-06 BE 중간 배포 주소. Swagger: http://54.180.152.1:8080/swagger-ui/index.html
VITE_API_BASE_URL=http://54.180.152.1:8080

# ── 도메인별 예외 (통합 과도기용) ─────────────────────────────
# 도메인: auth(로그인) user(설정) place(장소) safety(연락처) route(경로) chat(대화) history(기록)
#
# 전부 Mock 인 상태에서 특정 도메인만 실서버로 — 통합 시작할 때 이걸 씀
# VITE_REAL_DOMAINS=auth,user,place,safety
#
# 전부 실서버인 상태에서 특정 도메인만 Mock 으로
# VITE_MOCK_DOMAINS=route,chat
#
# ※ route·chat·history 는 BE 컨트롤러가 아직 없어(2026-08-04 API 명세서 기준)
#    실서버로 켜도 Mock 으로 유지됩니다. BE 배포되면 api/mode.ts 의 FORCED_MOCK 에서 빼세요.

# ── 카카오 로그인 (실서버 auth) ─────────────────────────────
# REST API 키(공개 키). redirect_uri 는 BE KAKAO_REDIRECT_URI + 카카오 콘솔 등록값과 글자까지 같아야 함.
# redirect_uri 를 비우면 런타임에 `${origin}/auth/kakao/callback` 을 쓴다.
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# (구) 카카오 로그인 붙이기 전, 실서버 검증용 임시 토큰. 카카오 로그인이 붙으면 불필요.
# VITE_DEV_ACCESS_TOKEN=
