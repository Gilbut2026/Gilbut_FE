# ===== 프로덕션 빌드 전용 (vite build 시 .env 를 덮어씀) =====
# Vercel 배포용. 비밀값 없음 → 커밋해도 됨.

# 빈 값 = 같은 오리진(/api/...) 으로 호출한다.
# vercel.json 의 rewrite 가 그 요청을 HTTP 백엔드(54.180.152.1:8080)로 프록시한다.
# → 브라우저는 HTTPS 로 Vercel 하고만 통신하므로 mixed content·CORS 문제가 사라진다.
VITE_API_BASE_URL=

# 2026-08-07: 카카오 redirect 등록(현영님)·MobilityAid enum(3값)·route 배포 확인됨 → 실서버 전환.
# 2026-08-15: 배포 BE /v3/api-docs 전수 대조 후 user·route·history 추가.
#   · user    — MobilityProfileSaveRequest 6필드가 온보딩과 완전 일치(slopeLevel 포함) 확인
#   · route   — POST /api/routes/recommendations 배포됨. drtGuide·accessibilitySummary 어댑터 반영 완료
#   · history — GET /api/routes/history 배포됨. route 가 돌면 이력이 쌓인다
#   · chat    — AI 서버가 BE 계약대로 재배포됨(2026-08-15 20시경). POST /api/chat 실호출로
#                PLACE_CANDIDATES 응답 확인. 화면도 ServerChatScreen 으로 재작성 완료.
#
# ⚠️ 시연 중 AI 챗이 느리거나 막히면 이 줄에서 chat 만 빼면 스크립트 대화 안전판으로 돌아간다.
#    (onrender 무료 플랜이라 한동안 안 쓰면 첫 요청에 40초 가까이 걸린다 — 시연 전 워밍업 권장)
VITE_REAL_DOMAINS=auth,place,safety,user,route,history,chat

# AI 서버 주소 — **깨우기 전용**이다. 대화·경로 요청은 전부 백엔드를 거친다.
# onrender 무료 플랜이라 유휴 시 잠들고 깨는 데 40초가 걸려서, 앱을 여는 순간
# /health 를 한 번 두드려 미리 깨워둔다 (src/api/warmup.ts).
# 이 줄을 지우면 깨우기만 건너뛰고 나머지는 그대로 동작한다.
VITE_AI_URL=https://gilbut-ai.onrender.com

# 카카오 지도 JavaScript 키 — 길 안내 화면의 지도에 쓴다.
# ⚠️ 로그인용 REST 키와는 **다른 키**다. 같은 앱일 필요도 없다(지도와 로그인은 별개 서비스).
# ⚠️ 카카오 개발자 콘솔 → 플랫폼 → Web → 사이트 도메인에 아래 둘을 등록해야 지도가 뜬다.
#      https://gilbut-ten.vercel.app
#      http://localhost:5173
# 비워두면 지도만 빠지고 길 안내는 단계 목록으로 그대로 동작한다.
VITE_KAKAO_JS_KEY=66a8a9c88ff6d1022711c28337fa1b61

# 카카오 REST 키(공개 키). Vercel 엔 .env 가 안 올라가므로 여기에 둔다.
# redirect_uri 는 지정 안 하면 런타임에 `${배포 origin}/auth/kakao/callback` 을 쓴다(= Vercel 도메인, 등록됨).
VITE_KAKAO_CLIENT_ID=8f3b61dce0d3cd418dbac40c6c2d2311
